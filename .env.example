API_PORT=4000
INSPECTOR_PORT=3000

# Durable state. When unset, the API falls back to an in-memory store, which is
# useful for local experiments and tests but loses runs on restart.
DATABASE_URL=postgresql://orchestrator:devpassword@localhost:5432/orchestrator

# Run queue. When unset, runs execute in-process. Set this to distribute node
# execution across workers with BullMQ retry policies.
REDIS_URL=redis://localhost:6379

# Retry policy applied to enqueued runs (BullMQ).
RUN_RETRY_ATTEMPTS=3
RUN_RETRY_BACKOFF_MS=2000

# LLM provider. When SARMALINK_API_KEY is unset the adapter runs in offline
# mode and returns deterministic output, so the stack runs with no provider.
SARMALINK_API_KEY=
SARMALINK_BASE_URL=https://api.sarmalink.ai/v1
DEFAULT_LLM=sarmalink

# OpenTelemetry. When OTEL_EXPORTER_OTLP_ENDPOINT is set, spans for every run,
# node, LLM call, and tool call are exported over OTLP/HTTP. When unset, spans
# are still created in-process but nothing is shipped off the box.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agent-orchestrator
